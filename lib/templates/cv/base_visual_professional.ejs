<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    CV - <%= nombre || "Currículum" %>
  </title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #e9edf2;
      font-family:
        "Arial",
        "Helvetica",
        sans-serif;
      color: #172033;
    }

    body {
      padding: 32px 0;
    }

    .page {
      width: 794px;
      min-height: 1123px;
      margin: 0 auto;
      background: #ffffff;
      display: grid;
      grid-template-columns: 250px 1fr;
      overflow: hidden;
    }

    /* SIDEBAR */

    .sidebar {
      position: relative;
      padding:
        58px
        28px
        48px;
      background: #edf3f7;
    }

    .sidebar::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 12px;
      background: #254b68;
    }

    .sidebar-section {
      margin-top: 34px;
    }

    .sidebar-section:first-child {
      margin-top: 0;
    }

    .sidebar-title {
      margin: 0 0 14px;
      color: #244762;
      font-size: 12px;
      line-height: 1.4;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .contact-item {
      margin: 0 0 12px;
      color: #344054;
      font-size: 11.5px;
      line-height: 1.55;
      overflow-wrap: anywhere;
    }

    .profile-text {
      margin: 0;
      color: #344054;
      font-size: 11.5px;
      line-height: 1.68;
    }

    .language-item {
      margin-bottom: 10px;
    }

    .language-name {
      margin: 0;
      color: #1d2939;
      font-size: 11.5px;
      line-height: 1.45;
      font-weight: 700;
    }

    .language-level {
      margin: 2px 0 0;
      color: #667085;
      font-size: 11px;
      line-height: 1.4;
    }

    .skills {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .skill {
      color: #344054;
      font-size: 11.5px;
      line-height: 1.45;
    }

    /* MAIN */

    .main {
      padding:
        52px
        46px
        52px
        48px;
    }

    .header {
      padding-bottom: 28px;
      border-bottom: 1px solid #d0d5dd;
    }

    .name {
      margin: 0;
      color: #1f4059;
      font-size: 34px;
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .profession {
      margin: 10px 0 0;
      color: #667085;
      font-size: 13px;
      line-height: 1.4;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .main-section {
      margin-top: 30px;
    }

    .main-title {
      position: relative;
      margin: 0 0 18px;
      padding-bottom: 8px;
      color: #244762;
      font-size: 13px;
      line-height: 1.4;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .main-title::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 42px;
      height: 2px;
      background: #254b68;
    }

    /* EDUCATION */

    .education-item {
      margin-bottom: 20px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .education-title {
      margin: 0;
      color: #101828;
      font-size: 13px;
      line-height: 1.45;
      font-weight: 700;
    }

    .education-institution {
      margin: 4px 0 0;
      color: #475467;
      font-size: 12px;
      line-height: 1.45;
      font-weight: 600;
    }

    .education-level {
      margin: 3px 0 0;
      color: #667085;
      font-size: 11.5px;
      line-height: 1.45;
    }

    /* EXPERIENCE */

    .experience-item {
      margin-bottom: 24px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .experience-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
    }

    .experience-main {
      flex: 1;
    }

    .experience-role {
      margin: 0;
      color: #101828;
      font-size: 13.5px;
      line-height: 1.4;
      font-weight: 700;
    }

    .experience-company {
      margin: 4px 0 0;
      color: #475467;
      font-size: 12px;
      line-height: 1.45;
      font-weight: 600;
    }

    .experience-period {
      margin: 2px 0 0;
      flex-shrink: 0;
      color: #667085;
      font-size: 11px;
      line-height: 1.4;
      font-weight: 500;
      text-align: right;
    }

    .experience-description {
      margin: 11px 0 0 16px;
      padding: 0;
    }

    .experience-description li {
      margin-bottom: 6px;
      padding-left: 3px;
      color: #344054;
      font-size: 11.5px;
      line-height: 1.55;
    }

    /* PRINT */

    @media print {
      html,
      body {
        background: #ffffff;
      }

      body {
        padding: 0;
      }

      .page {
        margin: 0;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <aside class="sidebar">

      <section class="sidebar-section">

        <h2 class="sidebar-title">
          Contacto
        </h2>

        <% if (contacto?.telefono) { %>
          <p class="contact-item">
            <%= contacto.telefono %>
          </p>
        <% } %>

        <% if (contacto?.email) { %>
          <p class="contact-item">
            <%= contacto.email %>
          </p>
        <% } %>

        <% if (contacto?.ubicacion) { %>
          <p class="contact-item">
            <%= contacto.ubicacion %>
          </p>
        <% } %>

        <% if (contacto?.web) { %>
          <p class="contact-item">
            <%= contacto.web %>
          </p>
        <% } %>

      </section>

      <% if (perfil) { %>

        <section class="sidebar-section">

          <h2 class="sidebar-title">
            Perfil
          </h2>

          <p class="profile-text">
            <%= perfil %>
          </p>

        </section>

      <% } %>

      <% if (
        idiomas &&
        idiomas.length > 0
      ) { %>

        <section class="sidebar-section">

          <h2 class="sidebar-title">
            Idiomas
          </h2>

          <% idiomas.forEach((item) => { %>

            <div class="language-item">

              <p class="language-name">
                <%= item.idioma %>
              </p>

              <% if (item.nivel) { %>
                <p class="language-level">
                  <%= item.nivel %>
                </p>
              <% } %>

            </div>

          <% }) %>

        </section>

      <% } %>

      <% if (
        habilidades &&
        habilidades.length > 0
      ) { %>

        <section class="sidebar-section">

          <h2 class="sidebar-title">
            Competencias
          </h2>

          <div class="skills">

            <% habilidades.forEach((item) => { %>

              <div class="skill">
                <%= item.nombre %>
              </div>

            <% }) %>

          </div>

        </section>

      <% } %>

    </aside>

    <section class="main">

      <header class="header">

        <h1 class="name">
          <%= nombre %>
        </h1>

        <% if (profesion) { %>

          <p class="profession">
            <%= profesion %>
          </p>

        <% } %>

      </header>

      <% if (
        educacion &&
        educacion.length > 0
      ) { %>

        <section class="main-section">

          <h2 class="main-title">
            Formación académica
          </h2>

          <% educacion.forEach((edu) => { %>

            <article class="education-item">

              <% if (edu.titulo) { %>

                <p class="education-title">
                  <%= edu.titulo %>
                </p>

              <% } else if (edu.nivel) { %>

                <p class="education-title">
                  <%= edu.nivel %>
                </p>

              <% } %>

              <% if (edu.institucion) { %>

                <p class="education-institution">
                  <%= edu.institucion %>
                </p>

              <% } %>

              <% if (
                edu.nivel &&
                edu.titulo
              ) { %>

                <p class="education-level">
                  <%= edu.nivel %>
                </p>

              <% } %>

            </article>

          <% }) %>

        </section>

      <% } %>

      <% if (
        experiencia &&
        experiencia.length > 0
      ) { %>

        <section class="main-section">

          <h2 class="main-title">
            Experiencia profesional
          </h2>

          <% experiencia.forEach((exp) => { %>

            <article class="experience-item">

              <div class="experience-heading">

                <div class="experience-main">

                  <% if (exp.puesto) { %>

                    <p class="experience-role">
                      <%= exp.puesto %>
                    </p>

                  <% } %>

                  <% if (exp.empresa) { %>

                    <p class="experience-company">
                      <%= exp.empresa %>
                    </p>

                  <% } %>

                </div>

                <% if (exp.periodo) { %>

                  <p class="experience-period">
                    <%= exp.periodo %>
                  </p>

                <% } %>

              </div>

              <% if (
                exp.descripcion &&
                exp.descripcion.length > 0
              ) { %>

                <ul class="experience-description">

                  <% exp.descripcion.forEach((item) => { %>

                    <li>
                      <%= item %>
                    </li>

                  <% }) %>

                </ul>

              <% } %>

            </article>

          <% }) %>

        </section>

      <% } %>

    </section>

  </main>

</body>
</html>
