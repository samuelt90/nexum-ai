<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    CV - <%= nombre || "Currículum" %>
  </title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #ece7e2;
      font-family:
        "Arial",
        "Helvetica",
        sans-serif;
      color: #26211f;
    }

    body {
      padding: 32px 0;
    }

    .page {
      position: relative;
      width: 794px;
      min-height: 1123px;
      margin: 0 auto;
      padding:
        58px
        58px
        54px;
      background: #f8f3ef;
      overflow: hidden;
    }

    .shape-top {
      position: absolute;
      top: -85px;
      left: -70px;
      width: 230px;
      height: 230px;
      border-radius: 50%;
      background: #d5a6a2;
    }

    .shape-side {
      position: absolute;
      top: 325px;
      right: -80px;
      width: 170px;
      height: 170px;
      border-radius: 50%;
      background: #7c4f46;
      opacity: 0.14;
    }

    .shape-bottom {
      position: absolute;
      bottom: -90px;
      left: 125px;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: #d5a6a2;
      opacity: 0.55;
    }

    .content {
      position: relative;
      z-index: 2;
    }

    /* HEADER */

    .header {
      display: grid;
      grid-template-columns: 260px 1fr;
      column-gap: 48px;
      align-items: end;
      margin-bottom: 42px;
    }

    .name {
      margin: 0;
      color: #2c2421;
      font-size: 38px;
      line-height: 0.98;
      font-weight: 700;
      letter-spacing: -1px;
    }

    .profession {
      margin: 11px 0 0;
      color: #7c4f46;
      font-size: 13px;
      line-height: 1.4;
      font-weight: 600;
    }

    .header-line {
      height: 1px;
      background: #a8847c;
      margin-bottom: 5px;
    }

    /* COLUMNS */

    .columns {
      display: grid;
      grid-template-columns: 260px 1fr;
      column-gap: 48px;
      align-items: start;
    }

    .left-column,
    .right-column {
      min-width: 0;
    }

    /* SECTION */

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      margin: 0 0 13px;
      color: #7c4f46;
      font-size: 15px;
      line-height: 1.35;
      font-weight: 700;
    }

    .section-title.main {
      color: #2c2421;
      font-size: 16px;
    }

    .profile {
      margin: 0;
      color: #3e3632;
      font-size: 11.5px;
      line-height: 1.68;
    }

    /* CONTACT */

    .contact-item {
      margin: 0 0 10px;
      color: #4a403c;
      font-size: 11px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    /* SKILLS */

    .skill-list {
      display: flex;
      flex-wrap: wrap;
      gap:
        8px
        7px;
    }

    .skill {
      padding:
        5px
        8px;
      border: 1px solid #b99890;
      border-radius: 999px;
      color: #594a45;
      font-size: 10.5px;
      line-height: 1.2;
    }

    /* LANGUAGES */

    .language {
      margin-bottom: 9px;
    }

    .language-name {
      margin: 0;
      color: #342d2a;
      font-size: 11.5px;
      line-height: 1.4;
      font-weight: 700;
    }

    .language-level {
      margin: 2px 0 0;
      color: #786b65;
      font-size: 10.5px;
      line-height: 1.4;
    }

    /* EDUCATION */

    .education-item {
      position: relative;
      margin-bottom: 22px;
      padding-left: 15px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .education-item::before {
      content: "";
      position: absolute;
      top: 5px;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #a36c63;
    }

    .education-title {
      margin: 0;
      color: #2b2522;
      font-size: 13px;
      line-height: 1.45;
      font-weight: 700;
    }

    .education-institution {
      margin: 4px 0 0;
      color: #625650;
      font-size: 11.5px;
      line-height: 1.45;
      font-weight: 600;
    }

    .education-level {
      margin: 3px 0 0;
      color: #82736c;
      font-size: 10.8px;
      line-height: 1.45;
    }

    /* EXPERIENCE */

    .experience-item {
      position: relative;
      margin-bottom: 25px;
      padding-left: 15px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .experience-item::before {
      content: "";
      position: absolute;
      top: 6px;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #a36c63;
    }

    .experience-role {
      margin: 0;
      color: #2b2522;
      font-size: 13px;
      line-height: 1.4;
      font-weight: 700;
    }

    .experience-company {
      margin: 4px 0 0;
      color: #625650;
      font-size: 11.5px;
      line-height: 1.45;
      font-weight: 600;
    }

    .experience-period {
      margin: 3px 0 0;
      color: #82736c;
      font-size: 10.8px;
      line-height: 1.4;
    }

    .experience-description {
      margin:
        10px
        0
        0
        16px;
      padding: 0;
    }

    .experience-description li {
      margin-bottom: 6px;
      padding-left: 2px;
      color: #4d433e;
      font-size: 11px;
      line-height: 1.55;
    }

    @media print {
      html,
      body {
        background: #ffffff;
      }

      body {
        padding: 0;
      }

      .page {
        margin: 0;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <div class="shape-top"></div>
    <div class="shape-side"></div>
    <div class="shape-bottom"></div>

    <div class="content">

      <header class="header">

        <div>

          <h1 class="name">
            <%= nombre %>
          </h1>

          <% if (profesion) { %>

            <p class="profession">
              <%= profesion %>
            </p>

          <% } %>

        </div>

        <div class="header-line"></div>

      </header>

      <div class="columns">

        <aside class="left-column">

          <% if (perfil) { %>

            <section class="section">

              <h2 class="section-title">
                Perfil
              </h2>

              <p class="profile">
                <%= perfil %>
              </p>

            </section>

          <% } %>

          <% if (
            idiomas &&
            idiomas.length > 0
          ) { %>

            <section class="section">

              <h2 class="section-title">
                Idiomas
              </h2>

              <% idiomas.forEach((item) => { %>

                <div class="language">

                  <p class="language-name">
                    <%= item.idioma %>
                  </p>

                  <% if (item.nivel) { %>

                    <p class="language-level">
                      <%= item.nivel %>
                    </p>

                  <% } %>

                </div>

              <% }) %>

            </section>

          <% } %>

          <% if (
            habilidades &&
            habilidades.length > 0
          ) { %>

            <section class="section">

              <h2 class="section-title">
                Habilidades
              </h2>

              <div class="skill-list">

                <% habilidades.forEach((item) => { %>

                  <span class="skill">
                    <%= item.nombre %>
                  </span>

                <% }) %>

              </div>

            </section>

          <% } %>

          <section class="section">

            <h2 class="section-title">
              Contacto
            </h2>

            <% if (contacto?.telefono) { %>

              <p class="contact-item">
                <%= contacto.telefono %>
              </p>

            <% } %>

            <% if (contacto?.email) { %>

              <p class="contact-item">
                <%= contacto.email %>
              </p>

            <% } %>

            <% if (contacto?.ubicacion) { %>

              <p class="contact-item">
                <%= contacto.ubicacion %>
              </p>

            <% } %>

            <% if (contacto?.web) { %>

              <p class="contact-item">
                <%= contacto.web %>
              </p>

            <% } %>

          </section>

        </aside>

        <section class="right-column">

          <% if (
            educacion &&
            educacion.length > 0
          ) { %>

            <section class="section">

              <h2 class="section-title main">
                Historial académico
              </h2>

              <% educacion.forEach((edu) => { %>

                <article class="education-item">

                  <% if (edu.titulo) { %>

                    <p class="education-title">
                      <%= edu.titulo %>
                    </p>

                  <% } else if (edu.nivel) { %>

                    <p class="education-title">
                      <%= edu.nivel %>
                    </p>

                  <% } %>

                  <% if (edu.institucion) { %>

                    <p class="education-institution">
                      <%= edu.institucion %>
                    </p>

                  <% } %>

                  <% if (
                    edu.nivel &&
                    edu.titulo
                  ) { %>

                    <p class="education-level">
                      <%= edu.nivel %>
                    </p>

                  <% } %>

                </article>

              <% }) %>

            </section>

          <% } %>

          <% if (
            experiencia &&
            experiencia.length > 0
          ) { %>

            <section class="section">

              <h2 class="section-title main">
                Trayectoria profesional
              </h2>

              <% experiencia.forEach((exp) => { %>

                <article class="experience-item">

                  <% if (exp.puesto) { %>

                    <p class="experience-role">
                      <%= exp.puesto %>
                    </p>

                  <% } %>

                  <% if (exp.empresa) { %>

                    <p class="experience-company">
                      <%= exp.empresa %>
                    </p>

                  <% } %>

                  <% if (exp.periodo) { %>

                    <p class="experience-period">
                      <%= exp.periodo %>
                    </p>

                  <% } %>

                  <% if (
                    exp.descripcion &&
                    exp.descripcion.length > 0
                  ) { %>

                    <ul class="experience-description">

                      <% exp.descripcion.forEach((item) => { %>

                        <li>
                          <%= item %>
                        </li>

                      <% }) %>

                    </ul>

                  <% } %>

                </article>

              <% }) %>

            </section>

          <% } %>

        </section>

      </div>

    </div>

  </main>

</body>
</html>