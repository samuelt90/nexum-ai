<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Currículum Vitae</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #ffffff;
    }

    body {
      font-family:
        Arial,
        Helvetica,
        sans-serif;

      color: #202631;

      font-size: 12.5px;
      line-height: 1.5;

      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cv {
      width: 794px;
      min-height: 1123px;

      margin: 0 auto;

      padding:
        50px
        60px
        52px;

      background: #ffffff;

      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    /* ==========================================
       ENCABEZADO
    ========================================== */

    .header {
      padding-bottom: 24px;

      border-bottom:
        2px solid #1d2939;
    }

    .name {
      margin: 0;

      color: #111827;

      font-size: 30px;
      line-height: 1.08;

      font-weight: 700;

      letter-spacing: -0.7px;
    }

    .profession {
      margin:
        10px
        0
        0;

      color: #4b5563;

      font-size: 13px;
      line-height: 1.4;

      font-weight: 700;

      letter-spacing: 0.8px;
      text-transform: uppercase;
    }

    .contact {
      margin-top: 18px;

      color: #4b5563;

      font-size: 11.5px;
      line-height: 1.6;
    }

    .contact-line {
      margin: 0;
    }

    .contact-line + .contact-line {
      margin-top: 2px;
    }

    .contact-item {
      display: inline;
    }

    .contact-separator {
      display: inline;

      margin:
        0
        7px;

      color: #98a2b3;
    }

    /* ==========================================
       SECCIONES
    ========================================== */

    .section {
      margin-top: 30px;
    }

    .section-title {
      margin: 0;

      padding-bottom: 6px;

      border-bottom:
        1px solid #d0d5dd;

      color: #1d2939;

      font-size: 11px;
      line-height: 1.3;

      font-weight: 700;

      letter-spacing: 1.25px;

      text-transform: uppercase;

      page-break-after: avoid;
      break-after: avoid;
    }

    .section-content {
      margin-top: 14px;
    }

    /* ==========================================
       PERFIL
    ========================================== */

    .profile {
      margin: 0;

      color: #344054;

      font-size: 12.5px;
      line-height: 1.7;
    }

    /* ==========================================
       EXPERIENCIA
    ========================================== */

.experience-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 24px;
}

.experience-main {
  flex: 1;
}

.experience-role {
  margin: 0;

  color: #101828;

  font-size: 13.5px;
  line-height: 1.4;

  font-weight: 700;
}

.experience-company {
  margin-top: 3px;

  color: #475467;

  font-size: 12px;
  line-height: 1.45;

  font-weight: 600;
}

.experience-period {
  margin: 1px 0 0;

  flex-shrink: 0;

  color: #667085;

  font-size: 11.5px;
  line-height: 1.4;

  font-weight: 500;

  text-align: right;
}


    /* ==========================================
       EDUCACIÓN
    ========================================== */

    .education-item {
      margin-bottom: 18px;

      page-break-inside: avoid;
      break-inside: avoid;
    }

    .education-item:last-child {
      margin-bottom: 0;
    }

    .education-title {
      margin: 0;

      color: #101828;

      font-size: 13px;
      line-height: 1.4;

      font-weight: 700;
    }

    .education-institution {
      margin-top: 4px;

      color: #475467;

      font-size: 12px;
      line-height: 1.45;

      font-weight: 600;
    }

    .education-level {
      margin-top: 3px;

      color: #667085;

      font-size: 11.5px;
      line-height: 1.45;
    }

    /* ==========================================
       HABILIDADES
    ========================================== */

    .skills {
      margin: 0;

      color: #344054;

      font-size: 12.2px;
      line-height: 1.65;
    }

    .skill {
      display: inline;
    }

    .skill-separator {
      display: inline;

      margin:
        0
        7px;

      color: #98a2b3;
    }

    /* ==========================================
       IDIOMAS
    ========================================== */

    .language-item {
      margin: 0;

      color: #344054;

      font-size: 12.2px;
      line-height: 1.5;

      page-break-inside: avoid;
      break-inside: avoid;
    }

    .language-item + .language-item {
      margin-top: 5px;
    }

    .language-name {
      color: #101828;

      font-weight: 700;
    }

    .language-level {
      color: #475467;
    }

    /* ==========================================
       IMPRESIÓN
    ========================================== */

    @page {
      size: A4;
      margin: 0;
    }

    @media print {
      html,
      body {
        width: 794px;
        min-height: 1123px;

        background: #ffffff;
      }

      .cv {
        width: 794px;

        margin: 0;
      }

      .section-title {
        page-break-after: avoid;
        break-after: avoid;
      }

      .experience-item,
      .education-item,
      .language-item {
        page-break-inside: avoid;
        break-inside: avoid;
      }
    }
  </style>
</head>

<body>
  <main class="cv">

    <!-- ========================================
         ENCABEZADO
    ========================================= -->

    <header class="header">

      <% if (nombre) { %>
        <h1 class="name">
          <%= nombre %>
        </h1>
      <% } %>

      <% if (profesion) { %>
        <p class="profession">
          <%= profesion %>
        </p>
      <% } %>

      <% if (
        contacto &&
        (
          contacto.telefono ||
          contacto.email ||
          contacto.ubicacion
        )
      ) { %>

        <div class="contact">

          <% if (
            contacto.telefono ||
            contacto.email
          ) { %>

            <p class="contact-line">

              <% if (contacto.telefono) { %>
                <span class="contact-item">
                  <%= contacto.telefono %>
                </span>
              <% } %>

              <% if (
                contacto.telefono &&
                contacto.email
              ) { %>
                <span class="contact-separator">
                  |
                </span>
              <% } %>

              <% if (contacto.email) { %>
                <span class="contact-item">
                  <%= contacto.email %>
                </span>
              <% } %>

            </p>

          <% } %>

          <% if (contacto.ubicacion) { %>

            <p class="contact-line">
              <%= contacto.ubicacion %>
            </p>

          <% } %>

        </div>

      <% } %>

    </header>


    <!-- ========================================
         PERFIL PROFESIONAL
    ========================================= -->

    <% if (perfil) { %>

      <section class="section">

        <h2 class="section-title">
          Perfil profesional
        </h2>

        <div class="section-content">

          <p class="profile">
            <%= perfil %>
          </p>

        </div>

      </section>

    <% } %>


    <!-- ========================================
         EXPERIENCIA PROFESIONAL
    ========================================= -->

    <% if (
      experiencia &&
      experiencia.length > 0
    ) { %>

      <section class="section">

        <h2 class="section-title">
          Experiencia profesional
        </h2>

        <div class="section-content">

          <% experiencia.forEach(exp => { %>

            <div class="experience-item">

 <div class="experience-heading">

  <div class="experience-main">

    <% if (exp.puesto) { %>

      <p class="experience-role">
        <%= exp.puesto %>
      </p>

    <% } %>

    <% if (exp.empresa) { %>

      <p class="experience-company">
        <%= exp.empresa %>
      </p>

    <% } %>

  </div>

  <% if (exp.periodo) { %>

    <p class="experience-period">
      <%= exp.periodo %>
    </p>

  <% } %>

</div>


              <% if (
                exp.descripcion &&
                exp.descripcion.length > 0
              ) { %>

                <ul class="experience-description">

                  <% exp.descripcion.forEach(item => { %>

                    <% if (item) { %>

                      <li>
                        <%= item %>
                      </li>

                    <% } %>

                  <% }) %>

                </ul>

              <% } %>

            </div>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- ========================================
         FORMACIÓN ACADÉMICA
    ========================================= -->

    <% if (
      educacion &&
      educacion.length > 0
    ) { %>

      <section class="section">

        <h2 class="section-title">
          Formación académica
        </h2>

        <div class="section-content">

          <% educacion.forEach(ed => { %>

            <div class="education-item">

              <% if (ed.titulo) { %>

                <p class="education-title">
                  <%= ed.titulo %>
                </p>

              <% } %>

              <% if (ed.institucion) { %>

                <p class="education-institution">
                  <%= ed.institucion %>
                </p>

              <% } %>

              <% if (ed.nivel) { %>

                <p class="education-level">
                  <%= ed.nivel %>
                </p>

              <% } %>

            </div>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- ========================================
         HABILIDADES
    ========================================= -->

    <% if (
      habilidades &&
      habilidades.length > 0
    ) { %>

      <section class="section">

        <h2 class="section-title">
          Habilidades
        </h2>

        <div class="section-content">

          <p class="skills">

            <% habilidades.forEach(
              (habilidad, index) => {
            %>

              <% const skillName =
                typeof habilidad === "string"
                  ? habilidad
                  : habilidad.nombre;
              %>

              <% if (skillName) { %>

                <span class="skill">
                  <%= skillName %>
                </span>

                <% if (
                  index <
                  habilidades.length - 1
                ) { %>

                  <span class="skill-separator">
                    |
                  </span>

                <% } %>

              <% } %>

            <% }) %>

          </p>

        </div>

      </section>

    <% } %>


    <!-- ========================================
         IDIOMAS
    ========================================= -->

    <% if (
      idiomas &&
      idiomas.length > 0
    ) { %>

      <section class="section">

        <h2 class="section-title">
          Idiomas
        </h2>

        <div class="section-content">

          <% idiomas.forEach(idioma => { %>

            <p class="language-item">

              <% if (idioma.idioma) { %>

                <span class="language-name">
                  <%= idioma.idioma %>
                </span>

              <% } %>

              <% if (
                idioma.idioma &&
                idioma.nivel
              ) { %>

                <span>
                  —
                </span>

              <% } %>

              <% if (idioma.nivel) { %>

                <span class="language-level">
                  <%= idioma.nivel %>
                </span>

              <% } %>

            </p>

          <% }) %>

        </div>

      </section>

    <% } %>

  </main>
</body>
</html>
