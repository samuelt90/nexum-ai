<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Currículum Vitae</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      background: #ffffff;
    }

    body {
      font-family:
        Arial,
        Helvetica,
        sans-serif;
      font-size: 13px;
      line-height: 1.5;
      color: #32394a;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .cv {
      width: 794px;
      min-height: 1123px;
      margin: 0 auto;
      padding: 52px 58px 54px;
      background: #ffffff;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }

    /* =========================
       ENCABEZADO
    ========================= */

    .header {
      padding-bottom: 18px;
      border-bottom: 2px solid #0d1633;
    }

    .name {
      margin: 0;
      font-size: 30px;
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -0.6px;
      color: #0d1633;
    }

    .profession {
      margin: 7px 0 0;
      font-size: 15px;
      line-height: 1.4;
      font-weight: 600;
      color: #596174;
    }

    .contact {
      margin-top: 15px;
      font-size: 12.5px;
      line-height: 1.6;
      color: #4d5567;
    }

    .contact-item {
      display: inline;
    }

    .contact-separator {
      display: inline;
      margin: 0 7px;
      color: #a1a6b0;
    }

    /* =========================
       SECCIONES
    ========================= */

    .section {
      margin-top: 26px;
    }

    .section-title {
      margin: 0;
      padding-bottom: 6px;
      border-bottom: 1px solid #cfd3dc;
      font-size: 12px;
      line-height: 1.3;
      font-weight: 700;
      letter-spacing: 1.1px;
      text-transform: uppercase;
      color: #0d1633;

      page-break-after: avoid;
      break-after: avoid;
    }

    .section-content {
      margin-top: 12px;
    }

    /* =========================
       TEXTO GENERAL
    ========================= */

    p {
      margin: 0;
    }

    .profile {
      font-size: 13px;
      line-height: 1.65;
      color: #394153;
    }

    strong {
      font-weight: 700;
      color: #0d1633;
    }

    /* =========================
       EXPERIENCIA
    ========================= */

    .experience-item {
      margin-bottom: 18px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .experience-item:last-child {
      margin-bottom: 0;
    }

    .experience-role {
      margin: 0;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 700;
      color: #0d1633;
    }

    .experience-meta {
      margin-top: 3px;
      font-size: 12.5px;
      line-height: 1.5;
      color: #62697a;
    }

    .experience-description {
      margin: 7px 0 0 18px;
      padding: 0;
    }

    .experience-description li {
      margin-bottom: 4px;
      padding-left: 2px;
      font-size: 13px;
      line-height: 1.55;
      color: #394153;
    }

    .experience-description li:last-child {
      margin-bottom: 0;
    }

    /* =========================
       EDUCACIÓN
    ========================= */

    .education-item {
      margin-bottom: 15px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .education-item:last-child {
      margin-bottom: 0;
    }

    .education-title {
      margin: 0;
      font-size: 13.5px;
      line-height: 1.45;
      font-weight: 700;
      color: #0d1633;
    }

    .education-institution {
      margin-top: 3px;
      font-size: 13px;
      color: #4f5769;
    }

    .education-level {
      margin-top: 2px;
      font-size: 12.5px;
      color: #737987;
    }

    /* =========================
       HABILIDADES
    ========================= */

    .skills {
      margin: 0;
      font-size: 13px;
      line-height: 1.7;
      color: #394153;
    }

    .skill {
      display: inline;
    }

    .skill-separator {
      display: inline;
      margin: 0 5px;
      color: #9ba0ab;
    }

    /* =========================
       IDIOMAS
    ========================= */

    .language-item {
      margin-bottom: 7px;
      font-size: 13px;
      line-height: 1.5;
      color: #394153;

      page-break-inside: avoid;
      break-inside: avoid;
    }

    .language-item:last-child {
      margin-bottom: 0;
    }

    .language-name {
      font-weight: 700;
      color: #0d1633;
    }

    .language-level {
      color: #5d6576;
    }

    /* =========================
       CERTIFICACIONES
    ========================= */

    .certification-item {
      margin-bottom: 14px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .certification-item:last-child {
      margin-bottom: 0;
    }

    .certification-name {
      font-size: 13.5px;
      font-weight: 700;
      color: #0d1633;
    }

    .certification-meta {
      margin-top: 3px;
      font-size: 12.5px;
      color: #62697a;
    }

    /* =========================
       IMPRESIÓN / PDF
    ========================= */

    @page {
      size: A4;
      margin: 0;
    }

    @media print {
      html,
      body {
        width: 794px;
        min-height: 1123px;
        background: #ffffff;
      }

      .cv {
        width: 794px;
        margin: 0;
      }

      .section-title {
        page-break-after: avoid;
      }

      .experience-item,
      .education-item,
      .language-item,
      .certification-item {
        page-break-inside: avoid;
      }
    }
  </style>
</head>

<body>
  <main class="cv">

    <!-- =========================
         ENCABEZADO
    ========================== -->

    <header class="header">
      <% if (nombre) { %>
        <h1 class="name"><%= nombre %></h1>
      <% } %>

      <% if (profesion) { %>
        <p class="profession">
          <%= profesion %>
        </p>
      <% } %>

      <div class="contact">
        <% let hasPreviousContact = false; %>

        <% if (contacto && contacto.telefono) { %>
          <span class="contact-item">
            <%= contacto.telefono %>
          </span>

          <% hasPreviousContact = true; %>
        <% } %>

        <% if (contacto && contacto.email) { %>
          <% if (hasPreviousContact) { %>
            <span class="contact-separator">•</span>
          <% } %>

          <span class="contact-item">
            <%= contacto.email %>
          </span>

          <% hasPreviousContact = true; %>
        <% } %>

        <% if (contacto && contacto.ubicacion) { %>
          <% if (hasPreviousContact) { %>
            <span class="contact-separator">•</span>
          <% } %>

          <span class="contact-item">
            <%= contacto.ubicacion %>
          </span>

          <% hasPreviousContact = true; %>
        <% } %>

        <% if (contacto && contacto.web) { %>
          <% if (hasPreviousContact) { %>
            <span class="contact-separator">•</span>
          <% } %>

          <span class="contact-item">
            <%= contacto.web %>
          </span>
        <% } %>
      </div>
    </header>


    <!-- =========================
         PERFIL
    ========================== -->

    <% if (perfil) { %>
      <section class="section">
        <h2 class="section-title">
          Perfil profesional
        </h2>

        <div class="section-content">
          <p class="profile">
            <%= perfil %>
          </p>
        </div>
      </section>
    <% } %>


    <!-- =========================
         EXPERIENCIA
    ========================== -->

    <% if (experiencia && experiencia.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          Experiencia laboral
        </h2>

        <div class="section-content">
          <% experiencia.forEach(exp => { %>
            <div class="experience-item">

              <% if (exp.puesto) { %>
                <p class="experience-role">
                  <%= exp.puesto %>
                </p>
              <% } %>

              <% if (exp.empresa || exp.periodo) { %>
                <p class="experience-meta">

                  <% if (exp.empresa) { %>
                    <span>
                      <%= exp.empresa %>
                    </span>
                  <% } %>

                  <% if (exp.empresa && exp.periodo) { %>
                    <span> · </span>
                  <% } %>

                  <% if (exp.periodo) { %>
                    <span>
                      <%= exp.periodo %>
                    </span>
                  <% } %>

                </p>
              <% } %>

              <% if (
                exp.descripcion &&
                exp.descripcion.length > 0
              ) { %>
                <ul class="experience-description">
                  <% exp.descripcion.forEach(d => { %>
                    <% if (d) { %>
                      <li><%= d %></li>
                    <% } %>
                  <% }) %>
                </ul>
              <% } %>

            </div>
          <% }) %>
        </div>
      </section>
    <% } %>


    <!-- =========================
         EDUCACIÓN
    ========================== -->

    <% if (educacion && educacion.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          Educación
        </h2>

        <div class="section-content">
          <% educacion.forEach(ed => { %>
            <div class="education-item">

              <% if (ed.titulo) { %>
                <p class="education-title">
                  <%= ed.titulo %>
                </p>
              <% } %>

              <% if (ed.institucion) { %>
                <p class="education-institution">
                  <%= ed.institucion %>
                </p>
              <% } %>

              <% if (ed.nivel) { %>
                <p class="education-level">
                  <%= ed.nivel %>
                </p>
              <% } %>

            </div>
          <% }) %>
        </div>
      </section>
    <% } %>


    <!-- =========================
         HABILIDADES
    ========================== -->

    <% if (habilidades && habilidades.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          Habilidades
        </h2>

        <div class="section-content">
          <p class="skills">
            <% habilidades.forEach((h, index) => { %>

              <% const skillName =
                typeof h === "string"
                  ? h
                  : h.nombre;
              %>

              <% if (skillName) { %>
                <span class="skill">
                  <%= skillName %>
                </span>

                <% if (index < habilidades.length - 1) { %>
                  <span class="skill-separator">•</span>
                <% } %>
              <% } %>

            <% }) %>
          </p>
        </div>
      </section>
    <% } %>


    <!-- =========================
         IDIOMAS
    ========================== -->

    <% if (idiomas && idiomas.length > 0) { %>
      <section class="section">
        <h2 class="section-title">
          Idiomas
        </h2>

        <div class="section-content">
          <% idiomas.forEach(idioma => { %>
            <p class="language-item">

              <% if (idioma.idioma) { %>
                <span class="language-name">
                  <%= idioma.idioma %>
                </span>
              <% } %>

              <% if (
                idioma.idioma &&
                idioma.nivel
              ) { %>
                <span> — </span>
              <% } %>

              <% if (idioma.nivel) { %>
                <span class="language-level">
                  <%= idioma.nivel %>
                </span>
              <% } %>

            </p>
          <% }) %>
        </div>
      </section>
    <% } %>


    <!-- =========================
         CERTIFICACIONES
    ========================== -->

    <% if (
      certificaciones &&
      certificaciones.length > 0
    ) { %>
      <section class="section">
        <h2 class="section-title">
          Certificaciones
        </h2>

        <div class="section-content">
          <% certificaciones.forEach(certificacion => { %>
            <div class="certification-item">

              <% if (certificacion.nombre) { %>
                <p class="certification-name">
                  <%= certificacion.nombre %>
                </p>
              <% } %>

              <% if (
                certificacion.institucion ||
                certificacion.fecha
              ) { %>
                <p class="certification-meta">

                  <% if (certificacion.institucion) { %>
                    <span>
                      <%= certificacion.institucion %>
                    </span>
                  <% } %>

                  <% if (
                    certificacion.institucion &&
                    certificacion.fecha
                  ) { %>
                    <span> · </span>
                  <% } %>

                  <% if (certificacion.fecha) { %>
                    <span>
                      <%= certificacion.fecha %>
                    </span>
                  <% } %>

                </p>
              <% } %>

            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

  </main>
</body>
</html>
