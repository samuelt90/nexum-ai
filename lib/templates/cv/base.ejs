<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
body {
  font-family: 'Inter', sans-serif;
  background: #e5e7eb;
  margin: 0;
  padding: 60px 20px;
}
/* FORMATO A4 */
.cv {
  width: 794px;
  height: 1123px;
  margin: auto;
  background: white;
  display: flex;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
}
.contacto svg {
  width: 14px;
  height: 14px;
  display: block;
}
.contacto span {
  display: flex;
  align-items: center;
}
.exp-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #6b7280;
  font-size: 13px;
  margin-bottom: 6px;
}
.exp-meta span:first-child {
  font-weight: 500;
}
.exp-meta span:last-child {
  color: #9ca3af;
}

/* HABILIDADES COMO BADGES */
.sidebar ul {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.skill {
  background: rgba(255,255,255,0.15);
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
}


/* SIDEBAR */
.sidebar {
  width: 30%;
  background: linear-gradient(180deg, #1e3a8a, #1e40af);
  color: white;
  padding: 120px 20px 30px 20px;
  position: relative;
  border-right: 4px solid #f59e0b;
}

.sidebar h3:nth-of-type(2){
    margin-top: 75px;
}

/* CONTACTO */
.contacto p {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 14px;
  word-break: break-word;
}
.contacto span {
  flex-shrink: 0;
}
.sidebar h3 {
  color: #fbbf24;
  font-size: 12px;
  letter-spacing: 1px;
  margin-top: 35px;
}
/* HABILIDADES */
.sidebar ul {
  list-style: none;
  padding-left: 0;
}
.sidebar li::before {
  content: "✔";
  margin-right: 8px;
  color: #fbbf24;
}
/* MAIN */
.main {
  width: 70%;
  padding: 80px 40px;
  display: flex;
  flex-direction: column;
}
/* HEADER */
.header {
  border-bottom: 3px solid #f59e0b;
  padding-bottom: 15px;
  margin-bottom: 70px;
}
.header h1 {
  margin: 0;
  font-size: 28px;
  font-weight: 700;
}
.header p {
  margin: 5px 0 0;
  color: #f59e0b;
  font-weight: 600;
}
/* SECTIONS */
.section {
  margin-bottom: 70px;
  padding-bottom: 10px;
  border-bottom: 1px solid #eee;
}
.section h2 {
  font-size: 14px;
  color: #1e3a8a;
  border-left: 5px solid #f59e0b;
  padding-left: 10px;
  margin-bottom: 12px;
}
/* ITEMS */
.item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 10px;
  font-size: 13px;
}
.item strong {
  display: block;
  font-weight: 600;
}
/* TIMELINE */
.item::before {
  content: "";
  width: 6px;
  height: 6px;
  background: #1e3a8a;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
}
/* QUITAR BULLET SOLO EN EXPERIENCIA */
.experiencia-section .item::before {
  display: none;
}
/* QUITAR BULLET EN EDUCACIÓN */
.section:nth-of-type(2) .item::before {
  display: none;
}
/* SOLO EXPERIENCIA */
.experiencia-section ul {
  margin-top: 6px;
  padding-left: 18px;
}
.experiencia-section ul li {
  font-size: 13px;
  margin-bottom: 4px;
  list-style: none;
  position: relative;
}
.experiencia-section ul li::before {
  content: "";
  position: absolute;
  left: -14px;
  top: 6px;
  width: 8px;
  height: 8px;
  background: #1e3a8a;
  border-radius: 50%;
}
/* JERARQUÍA EXPERIENCIA */
.item span {
  color: #6b7280;
  font-weight: 500;
}
/* UNIFICAR TEXTO DE CONTENIDO */
.contacto p,
.sidebar li,
.item,
.section p {
  font-size: 13px;
  line-height: 1.6;
}
</style>
</head>
<body>
<div class="cv">
<div class="sidebar">
  <h3>CONTACTO</h3>
  <div class="contacto">
  <p>
    <span>
      <svg viewBox="0 0 24 24" fill ="none" stroke="white" stroke-width="2">
        <path d="M2 2h3l2 5-2 2a11 11 0 005 5l2-2 5 2v3a2 2 0 01-2 2A16 16 0 012 4a2 2 0 012-2z"/>
      </svg>
    </span>
    502 5555 5555
  </p>
  <p>
    <span>
      <svg viewBox="0 0 24 24" fill ="none" stroke="white" stroke-width="2">
        <rect x="2" y="4" width="16" height="12" rx="2"/>
        <path d="M2 6l8 6 8-6"/>
      </svg>
    </span>
    samuel.torres@email.com
  </p>
  <p>
    <span>
      <svg viewBox="0 0 24 24" fill ="none" stroke="white" stroke-width="2">
        <path d="M12 10a4 4 0 100-8 4 4 0 000 8z"/>
        <path d="M12 10c-4 6-6 8-6 8s2-2 6-2 6 2 6 2-2-2-6-8z"/>
      </svg>
    </span>
    Villa Nueva, Guatemala
  </p>
  <p>
    <span>
      <svg viewBox="0 0 24 24" fill ="none" stroke="white" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/>
      </svg>
    </span>
    www.samueltores.dev
  </p>
</div>
  <h3>HABILIDADES</h3>
  <ul>
    <% habilidades.forEach(h => { %>
      <li class="skill"><%= h.nombre %></li>
    <% }) %>
  </ul>
</div>

<div class="main">
<div class="header">
  <h1><%= nombre %></h1>
  <p><%= profesion %></p>
</div>

<div class="section experiencia-section">
  <h2>EXPERIENCIA</h2>
  <% experiencia.forEach(exp => { %>
  <div class="item">
    <div>
      <strong><%= exp.puesto %></strong>
      <div class="exp-meta">
        <span><%= exp.empresa %></span>
        <span><%= exp.fecha %></span>
      </div>
      <ul>
        <% exp.descripcion.forEach(d => { %>
          <li><%= d %></li>
        <% }) %>
      </ul>
    </div>
  </div>
<% }) %>
</div>

<div class="section">
  <h2>EDUCACIÓN</h2>
  <% educacion.forEach(ed => { %>
    <div class="item">
      <div>
        <strong><%= ed.titulo %></strong>
        <div class="exp-meta">
          <span><%= ed.institucion %></span>
          <span><%= ed.fecha %></span>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="section">
  <h2>PERFIL</h2>
  <p><%= perfil %></p>
</div>

</div>
</div>
</body>
</html>
