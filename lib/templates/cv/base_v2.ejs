<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
body {
  font-family: 'Inter', sans-serif;
  margin: 0;
  padding: 40px;
  background: #f4f1ed;
}

/* CONTENEDOR */
.cv {
  width: 794px;
  height: 1123px; /* A4 */
  margin: auto;
  display: flex;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  border-radius: 10px;
  overflow: hidden;
  background: white;
}


/* SIDEBAR */
.sidebar {
  width: 30%;
  background: #f0ebe5;
  padding: 80px 20px 30px 20px;
  color: #4a4a4a;
}

.sidebar h3 {
  font-size: 12px;
  letter-spacing: 2px;
  margin-top: 30px;
  color: #7a5c3e;
}

/* CONTACTO */
.contacto p {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon {
  width: 14px;
  height: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a5c3e;
}

.icon svg {
  width: 14px;
  height: 14px;
}

/* TEXTO */
.sidebar p {
  font-size: 13px;
  line-height: 1.6;
}

/* SKILLS */
.skills {
  margin-top: 10px;
}

.skill-bar {
  margin-bottom: 10px;
}

.skill-bar span {
  font-size: 12px;
}

.top-bar {
    height: 60px;
    background: #3f3f3f;
    margin: -40px -40px 0 -40px;
}
.bar {
  height: 4px;
  background: #d6c8b8;
  border-radius: 2px;
  margin-top: 3px;
}


/* MAIN */
.main {
  width: 70%;
  background: #3f3f3f;
  color: white;
  padding: 40px;
  overflow: hidden;
}

/* HEADER BLOQUE COMPLETO */
.header-full {
  background: #f0ebe5;
  margin: 0 -40px 60px -40px;
  padding: 30px;
}

.header-full h1 {
  margin: 0;
  font-size: 32px;
  font-weight: 600;
  color: #2d2d2d;
}

.header-full p {
  margin-top: 6px;
  font-size: 13px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #7a5c3e;
}

/* SECTIONS */
.section {
  margin-top: 30px;
}

/* TITULOS */
.section-title {
  background: #bfa98e;
  color: #fff;
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 20px;
  display: inline-block;
  margin-bottom: 15px;
  letter-spacing: 1px;
}

/* ITEMS */
.item {
  margin-bottom: 20px;
  font-size: 13px;
}

.item strong {
  display: block;
  font-weight: 600;
  color: #fff;
}

/* META */
.meta {
  font-size: 12px;
  color: #d0d0d0;
  margin-bottom: 6px;
}

/* LISTAS */
ul {
  margin: 6px 0 0;
  padding-left: 16px;
}

ul li {
  margin-bottom: 4px;
}

/* PERFIL */
.perfil {
  font-size: 13px;
  line-height: 1.6;
  color: #e0e0e0;
}
</style>
</head>

<body>

<div class="cv">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <h3>CONTACTO</h3>
    <div class="contacto">

  <% if (contacto.telefono) { %>
    <p>
      <span class="icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 3.11 5.18 2 2 0 0 1 5.1 3h3a2 2 0 0 1 2 1.72c.12.9.37 1.77.72 2.6a2 2 0 0 1-.45 2.11L9.91 10.91a16 16 0 0 0 6.18 6.18l1.48-1.48a2 2 0 0 1 2.11-.45c.83.35 1.7.6 2.6.72A2 2 0 0 1 22 16.92z"/>
        </svg>
      </span>
      <%= contacto.telefono %>
    </p>
  <% } %>

  <% if (contacto.email) { %>
    <p>
      <span class="icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="M22 6l-10 7L2 6"/>
        </svg>
      </span>
      <%= contacto.email %>
    </p>
  <% } %>

  <% if (contacto.ubicacion) { %>
    <p>
      <span class="icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-6-5.33-6-10a6 6 0 0 1 12 0c0 4.67-6 10-6 10z"/>
          <circle cx="12" cy="11" r="2"/>
        </svg>
      </span>
      <%= contacto.ubicacion %>
    </p>
  <% } %>

  <% if (contacto.web) { %>
    <p>
      <span class="icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/>
        </svg>
      </span>
      <%= contacto.web %>
    </p>
  <% } %>

</div>


    <h3>PERFIL</h3>
    <p><%= perfil %></p>

    <h3>HABILIDADES</h3>
    <div class="skills">
      <% habilidades.forEach(h => { %>
        <div class="skill-bar">
          <span><%= h.nombre %></span>
          <div class="bar"></div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">
    <div class="top-bar"></div>
    <!-- CAMBIO AQUÍ -->
    <div class="header-full">
      <h1><%= nombre %></h1>
      <p><%= profesion %></p>
    </div>

    <div class="section">
      <div class="section-title">EXPERIENCIA PROFESIONAL</div>

      <% experiencia.forEach(exp => { %>
        <div class="item">
          <strong><%= exp.puesto %></strong>
          <div class="meta"><%= exp.empresa %> · <%= exp.fecha %></div>

          <ul>
            <% exp.descripcion.forEach(d => { %>
              <li><%= d %></li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>

    <div class="section">
      <div class="section-title">FORMACIÓN ACADÉMICA</div>

      <% educacion.forEach(ed => { %>
        <div class="item">
          <strong><%= ed.titulo %></strong>
          <div class="meta"><%= ed.institucion %> · <%= ed.fecha %></div>
        </div>
      <% }) %>
    </div>

  </div>

</div>

</body>
</html>
